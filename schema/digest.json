{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://space-cadet.github.io/cron-digests/schema/digest.json",
  "title": "Cron Digest",
  "description": "Schema for cron-digests markdown files — arXiv and Web Science",
  "type": "object",
  "required": ["header", "entries"],
  "properties": {
    "header": {
      "type": "object",
      "required": ["title", "date", "items_found", "focus"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Digest title line, e.g. 'arXiv Digest — 2026-05-18'",
          "pattern": "^.+ Digest — \\d{4}-\\d{2}-\\d{2}$"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "ISO date from filename"
        },
        "type": {
          "type": "string",
          "enum": ["arxiv", "web-science"],
          "description": "Digest category stream"
        },
        "categories": {
          "type": "string",
          "description": "For arXiv: comma-separated arXiv categories (e.g. 'hep-th, gr-qc, quant-ph')"
        },
        "sites": {
          "type": "string",
          "description": "For web-science: source sites (e.g. 'Phys.org + ScienceDaily')"
        },
        "items_found": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of entries in the digest"
        },
        "focus": {
          "type": "string",
          "description": "Brief comma-separated topic summary"
        }
      },
      "oneOf": [
        {
          "required": ["categories"],
          "properties": { "type": { "const": "arxiv" } }
        },
        {
          "required": ["sites"],
          "properties": { "type": { "const": "web-science" } }
        }
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "title", "url", "relevance", "tags"],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "description": "Sequential entry number (1-based)"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Paper or article title"
          },
          "authors": {
            "type": "string",
            "description": "For arXiv: author list"
          },
          "source": {
            "type": "string",
            "description": "For web-science: publication source"
          },
          "arxiv_id": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{4,5}$",
            "description": "arXiv identifier (e.g. 2605.15251)"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Link to paper or article"
          },
          "categories": {
            "type": "string",
            "description": "For arXiv: source categories (e.g. 'hep-th, gr-qc')"
          },
          "summary": {
            "type": "string",
            "description": "Brief abstract or description"
          },
          "relevance": {
            "type": "string",
            "minLength": 10,
            "description": "Why this item matters — 1-3 sentences"
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 2
            },
            "description": "Subject tags from tags.json registry"
          }
        }
      }
    }
  }
}
